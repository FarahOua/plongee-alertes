# Copie ce fichier en .env et remplis ce dont tu as besoin.
# Seule la base est obligatoire. Sans le reste : mails écrits dans outbox/, texte gabarit.

# --- Base de données : Supabase → Connect → Session pooler (URI) ---
DATABASE_URL=
# Base de test (second projet Supabase) : vidée à chaque lancement de pytest. Jamais la production.
TEST_DATABASE_URL=

# --- URLs (liens dans les mails) ---
# En local : http://localhost:5000 et http://localhost:8501
# Déployé : l'adresse de l'API (Render) et l'adresse du site (Streamlit)
PUBLIC_BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8501

# --- Texte du mail par IA gratuite (facultatif) ---
# Google Gemini (gratuit, sans carte) : https://aistudio.google.com/apikey → Create API key
GEMINI_API_KEY=

# --- Envoi des mails (facultatif) ---
# API HTTPS de Brevo. Clé : app.brevo.com → Paramètres → SMTP & API → Clés API (xkeysib-…).
# Vérifie l'adresse de MAIL_FROM dans Brevo → Expéditeurs.
BREVO_API_KEY=
MAIL_FROM=Alertes Plongée <alertes@ton-domaine.fr>

# --- Open-Meteo commercial (seulement si l'appli devient payante) ---
OPEN_METEO_API_KEY=

# --- Visibilité estimée (facultatif) ---
# Compte gratuit : https://marine.copernicus.eu/register
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
